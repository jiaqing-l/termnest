{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termnest",
  "version": "1.1.4",
  "identifier": "com.jiaqing.termnest",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; frame-src 'none'; object-src 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "resources/": "app/"
    }
  }
}
